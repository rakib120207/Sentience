# ══════════════════════════════════════════════════════════════════
#  Sentience Finance v2 — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or firebase-key.json to git.
# ══════════════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────────────
# Your Gemini API key from https://aistudio.google.com/apikey
# Free tier works — no billing required for this project.
GOOGLE_API_KEY=your_gemini_api_key_here

# ── OPTIONAL: Firebase Firestore ──────────────────────────────────
# Without this the app runs in demo mode (data is lost on restart).
# To enable persistence:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (or use existing)
#   3. Project Settings → Service Accounts → Generate New Private Key
#   4. Save as firebase-key.json in this folder
#
# The app loads firebase-key.json automatically if it exists.
# Alternatively encode it for Cloud Run deployment:
#   Linux/Mac:  base64 -i firebase-key.json | tr -d '\n'
#   Windows PS: [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-key.json"))
FIREBASE_KEY_BASE64=

# ── CLOUD RUN (only needed for deploy.sh) ─────────────────────────
# Your GCP project ID — find it at https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT=your_gcp_project_id

# ── OPTIONAL TUNING ───────────────────────────────────────────────
# Port the backend listens on (default: 8000)
# PORT=8000

# Rate limiting — requests per minute per IP (default: 60)
# RATE_LIMIT=60
